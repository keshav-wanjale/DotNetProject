<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Moved from AssemblyInfo.cs -->
    <AssemblyTitle>WebApiExample.WebApp</AssemblyTitle>
    <AssemblyDescription></AssemblyDescription>
    <AssemblyCompany></AssemblyCompany>
    <AssemblyProduct>WebApiExample.WebApp</AssemblyProduct>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Enable XML documentation file generation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Consolidated NuGet package references (converted from packages.config) -->
  <ItemGroup>
    <PackageReference Include="Antlr" Version="3.5.0.2" />
    <PackageReference Include="bootstrap" Version="3.3.7" />
    <PackageReference Include="jQuery" Version="3.3.1" />
    <PackageReference Include="Modernizr" Version="2.8.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.2" />

    <!-- Additional ASP.NET Core support -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.0" />

    <!-- EF Core 8.x packages -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
  </ItemGroup>

  <!-- Include JSON configuration files and copy them to the output directory -->
  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Exclude legacy files and folders -->
  <ItemGroup>
    <!-- Web.config transforms -->
    <None Remove="Web.config" />
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
    <None Remove="Areas\HelpPage\Views\Web.config" />
    <None Remove="Views\Web.config" />

    <!-- Global.asax and App_Start -->
    <Content Remove="Global.asax" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start\**\*.cs" />
    <None Remove="App_Start\**\*.cs" />

    <!-- Legacy static assets -->
    <Content Remove="Scripts\**\*.*" />
    <Content Remove="Content\**\*.*" />

    <!-- HelpPage area -->
    <Compile Remove="Areas\HelpPage\**\*.cs" />
    <Content Remove="Areas\HelpPage\**\*" />
    <None Remove="Areas\HelpPage\**\*" />

    <!-- Deprecated packages.config -->
    <None Remove="packages.config" />
  </ItemGroup>
</Project>