<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy Web.config preserved for reference; not used in .NET Core -->
<configuration>
  <!-- Removed obsolete sections and packages:
       - Microsoft.AspNet.WebApi
       - Microsoft.Web.Infrastructure
       - System.Web.* assemblies
       - Web API HelpPage and Optimization assemblies
       - Entity Framework 6 sections
  -->
  <connectionStrings>
    <add name="UserContext" connectionString="Server=localhost\SQLEXPRESS;Database=WebApiExample;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <handlers>
      <!-- Handlers removed, migrate routing to ASP.NET Core -->
    </handlers>
  </system.webServer>
</configuration>