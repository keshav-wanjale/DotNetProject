@model WebApiExample.WebApp.Models.HomeIndexViewModel

<div class="jumbotron">
    <h1>@Model.Title</h1>
    <p class="lead">@Model.LeadText</p>
    <p>
        <a class="btn btn-primary btn-lg" href="https://asp.net" role="button">
            Learn more &raquo;
        </a>
    </p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Getting started</h2>
        <p>
            ASP.NET Web API is a framework that makes it easy to build HTTP services that reach
            a broad range of clients, including browsers and mobile devices. ASP.NET Web API
            is an ideal platform for building RESTful applications on the .NET Framework.
        </p>
        <p>
            <a class="btn btn-default" href="https://go.microsoft.com/fwlink/?LinkId=301870" role="button">
                Learn more &raquo;
            </a>
        </p>
    </div>
    <div class="col-md-4">
        <h2>Get more libraries</h2>
        <p>
            NuGet is a free Visual Studio extension that makes it easy to add, remove, and update libraries and tools in Visual Studio projects.
        </p>
        <p>
            <a class="btn btn-default" href="https://go.microsoft.com/fwlink/?LinkId=301871" role="button">
                Learn more &raquo;
            </a>
        </p>
    </div>
    <div class="col-md-4">
        <h2>Users API</h2>
        <p>
            View and manage users via the API.
        </p>
        <p>
            <a asp-controller="Users" asp-action="Get" class="btn btn-default" role="button">
                View Users &raquo;
            </a>
        </p>
    </div>
</div>
